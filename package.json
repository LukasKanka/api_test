{
  "name": "api-test-playground",
  "version": "1.0.0",
  "description": "Monorepo for API testing playground with Bruno and Vibe agents",
  "private": true,
  "workspaces": [
    "backends/*",
    "backends/*/frontend",
    "apiTest/*"
  ],
  "scripts": {
    "setup": "npm install",
    "start:all": "concurrently \"npm run start:backends\" \"npm run test:watch\"",
    "start:backends": "cd backends/potter-api && npm start",
    "start:potter-api": "cd backends/potter-api && npm start",
    "start:potter-fe": "cd backends/potter-api/frontend && npm run serve",
    "test:all": "for dir in $(find apiTest -mindepth 1 -maxdepth 1 -type d ! -name \"node_modules\" ! -name \".git\" | sort); do cd \"$dir\" && npx @usebruno/cli run -r && cd ../.. || exit 1; done",
    "test:potter": "cd apiTest/PotterAPI && npx @usebruno/cli run -r",
    "test:watch": "cd apiTest/PotterAPI && npx @usebruno/cli run -r --watch",
    "lint": "echo \"Linting all workspaces\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "api-testing",
    "bruno",
    "monorepo",
    "potter-api"
  ],
  "author": "",
  "license": "ISC"
}
